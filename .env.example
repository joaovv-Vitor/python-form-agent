MODEL_PROFILE=deepseek
DEEPSEEK_API_KEY=coloque_sua_chave_aqui
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

# Extração estruturada: perfil deepseek independente do agente de formulário.
# Usa DEEPSEEK_API_KEY; EXTRACTION_API_KEY permite uma chave separada.
# Padrões: modelo do perfil deepseek, temperatura 0, timeout 60 s.
# EXTRACTION_MODEL=deepseek-v4-flash
# EXTRACTION_TEMPERATURE=0
# EXTRACTION_TIMEOUT_SECONDS=60
# EXTRACTION_BASE_URL=https://api.deepseek.com

HEADLESS=false
BROWSER_TIMEOUT_MS=30000
# FORM_URL=https://exemplo.com/formulario
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

AGENT_MAX_TURNS=8
EVALUATION_ATTEMPTS=3
LOG_LEVEL=WARNING

# Deixe ausente para usar o padrão do provider (nem todo modelo aceita temperatura).
# LLM_TEMPERATURE=0
FORM_PROMPT_VERSION=form-agent-v2
# Exige um indicador real específico do formulário usado no experimento.
# SUBMISSION_SUCCESS_SELECTOR=[data-form-agent-submitted="true"]

# Aplicação web V1 (formulário padrão; Chromium headless).
# WEB_DATA_DIR=reports/web
# WEB_FRONTEND_DIR=frontend/dist
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# WEB_STT_MODEL=large-v3
# WEB_MAX_SESSIONS=1
# WEB_MAX_UPLOAD_BYTES=26214400
# WEB_MAX_AUDIO_SECONDS=120
# WEB_IDLE_SECONDS=900
# WEB_OPERATION_SECONDS=600
# No homelab, configure sua origem HTTPS e cookies seguros:
# WEB_PUBLIC_ORIGIN=https://formularios.seu-dominio.com
# WEB_COOKIE_SECURE=true
