MODEL_PROFILE=deepseek
DEEPSEEK_API_KEY=coloque_sua_chave_aqui
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

HEADLESS=false
BROWSER_TIMEOUT_MS=30000
# FORM_URL=https://exemplo.com/formulario
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

AGENT_MAX_TURNS=8
EVALUATION_ATTEMPTS=3
LOG_LEVEL=WARNING

# Deixe ausente para usar o padrão do provider (nem todo modelo aceita temperatura).
# LLM_TEMPERATURE=0
FORM_PROMPT_VERSION=form-agent-v2
# Exige um indicador real específico do formulário usado no experimento.
# SUBMISSION_SUCCESS_SELECTOR=[data-form-agent-submitted="true"]
