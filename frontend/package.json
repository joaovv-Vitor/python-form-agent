{
  "name": "form-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "5.7.3",
    "vite": "8.3.5"
  }
}
